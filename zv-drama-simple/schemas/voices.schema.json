            "required": [
              "checked",
              "singleSpeaker",
              "cleanSpeech",
              "notes"
            ],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "characterId",
          "characterName",
          "characterFingerprint",
          "description",
          "file",
          "sha256",
          "url",
          "status",
          "source",
          "qc",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "voices"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "voices"
