{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "voices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1
          },
          "characterName": {
            "type": "string",
            "minLength": 1
          },
          "characterFingerprint": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 0
          },
          "status": {
            "enum": [
              "local",
              "ready"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1
              },
              "segmentId": {
                "type": "string",
                "minLength": 1
              },
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "videoFile": {
                "type": "string",
                "minLength": 1
              },
              "videoSha256": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "beatIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "transcript": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "jobId",
              "segmentId",
              "taskId",
              "videoFile",
              "videoSha256",
              "start",
              "end",
              "beatIds",
              "transcript"
            ],
            "additionalProperties": false
          },
          "qc": {
            "type": "object",
            "properties": {
              "checked": {
                "const": true
              },
              "singleSpeaker": {
                "const": true
              },
              "cleanSpeech": {
                "const": true
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
