{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "episodeId": {
            "type": "string",
            "minLength": 1
          },
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "ref2v",
              "fl2v"
            ]
          },
          "sound": {
            "type": "string",
            "minLength": 1
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "beatIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "seconds": {
                  "type": "number",
                  "minimum": 0.1
                },
                "size": {
                  "type": "string",
                  "minLength": 1
                },
                "camera": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "composition": {
                  "type": "string",
                  "minLength": 1
                },
                "framePrompt": {
                  "type": "string",
                  "minLength": 1
                },
                "assetIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "startState": {
                  "type": "string",
                  "minLength": 1
                },
                "endState": {
                  "type": "string",
                  "minLength": 1
                },
                "spatial": {
                  "type": "object",
                  "properties": {
                    "floorplanId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cameraPath": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": 0
                          },
                          "y": {
                            "type": "number",
                            "minimum": 0
                          },
                          "lookAtX": {
                            "type": "number",
                            "minimum": 0
                          },
                          "lookAtY": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "lookAtX",
                          "lookAtY"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "visibleItemIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 0
                    },
                    "backgroundChange": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "floorplanId",
                    "cameraPath",
                    "visibleItemIds",
                    "backgroundChange"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "beatIds",
                "seconds",
                "size",
                "camera",
                "action",
                "composition",
                "framePrompt",
                "assetIds",
                "startState",
                "endState",
                "spatial"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "modeReason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "episodeId",
          "sceneId",
          "mode",
          "sound",
          "shots",
          "modeReason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "segments"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "storyboard"
}
