{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "seconds": {
            "type": "number",
            "minimum": 0.1
          },
          "qc": {
            "type": "object",
            "properties": {
              "checked": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "checked",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "segmentId",
          "taskId",
          "file",
          "seconds",
          "qc"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "clips"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clips.schema.json",
  "title": "clips"
}
