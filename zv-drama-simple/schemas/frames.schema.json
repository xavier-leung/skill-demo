{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "keyframe",
              "first_frame",
              "last_frame"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "qc": {
            "type": "object",
            "description": "仅兼容旧项目历史数据；本分支不读取、不要求图片 QC。"
          }
        },
        "required": [
          "id",
          "segmentId",
          "shotId",
          "role",
          "file",
          "prompt",
          "referenceIds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "images"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frames.schema.json",
  "title": "frames"
}
