{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "view": {
            "const": "overhead"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "qc": {
            "type": "object",
            "properties": {
              "checked": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              },
              "contextFingerprint": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requirement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "priority": {
                      "enum": [
                        "critical",
                        "normal"
                      ]
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "id",
                    "requirement",
                    "priority",
                    "weight"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attempt": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "correction": {
                      "type": "string"
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "criterionId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "result": {
                            "enum": [
                              "pass",
                              "fail",
                              "uncertain"
                            ]
                          },
                          "observation": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "criterionId",
                          "result",
                          "observation"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "attempt",
                    "file",
                    "sha256",
                    "prompt",
                    "correction",
                    "checks"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "selectedAttempt": {
                "type": "integer",
                "minimum": 0
              },
              "outcome": {
                "enum": [
                  "pending",
                  "passed",
                  "best_available"
                ]
              }
            },
            "required": [
              "checked",
              "notes",
              "contextFingerprint",
              "criteria",
              "attempts",
              "selectedAttempt",
              "outcome"
            ],
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "orientation": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "wall",
                        "door",
                        "window",
                        "furniture",
                        "passage",
                        "anchor"
                      ]
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "sittable": {
                      "type": "boolean"
                    },
                    "blocksCamera": {
                      "type": "boolean"
                    },
                    "basis": {
                      "enum": [
                        "observed",
                        "inferred"
                      ]
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "kind",
                    "x",
                    "y",
                    "width",
                    "height",
                    "sittable",
                    "blocksCamera",
                    "basis",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "unknownZones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "spatialNotes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "orientation",
              "items",
              "unknownZones",
              "spatialNotes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "entityId",
          "view",
          "file",
          "prompt",
          "referenceIds",
          "qc",
          "layout"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "images"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "floorplans.schema.json",
  "title": "floorplans"
}
