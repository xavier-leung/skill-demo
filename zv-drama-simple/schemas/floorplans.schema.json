{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "view": {
            "const": "overhead"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "qc": {
            "type": "object",
            "description": "仅兼容旧项目历史数据；本分支不读取、不要求图片 QC。"
          },
          "layout": {
            "type": "object",
            "properties": {
              "orientation": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "wall",
                        "door",
                        "window",
                        "furniture",
                        "passage",
                        "anchor"
                      ]
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "sittable": {
                      "type": "boolean"
                    },
                    "blocksCamera": {
                      "type": "boolean"
                    },
                    "basis": {
                      "enum": [
                        "observed",
                        "inferred"
                      ]
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "kind",
                    "x",
                    "y",
                    "width",
                    "height",
                    "sittable",
                    "blocksCamera",
                    "basis",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "unknownZones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0.001
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "spatialNotes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "orientation",
              "items",
              "unknownZones",
              "spatialNotes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "entityId",
          "view",
          "file",
          "prompt",
          "referenceIds",
          "layout"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "images"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "floorplans.schema.json",
  "title": "floorplans"
}
